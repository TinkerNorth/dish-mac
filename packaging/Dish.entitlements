<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime (release.yml signs with `--options runtime`) blocks
         every audio-input API unless the app holds this entitlement. Dish
         captures a controller's own microphone, so without it a signed build
         would open no mic while an unsigned local build works. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
