    "%@ stopped responding. Input isn’t getting through. It may be asleep or off your network." : {
      "comment" : "The setup walk: stopped responding.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je prestao odgovarati. Unos ne prolazi. Možda je u mirovanju ili izvan vaše mreže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reagiert nicht mehr. Eingaben kommen nicht an. Möglicherweise im Ruhezustand oder nicht im Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dejó de responder. La entrada no está llegando. Puede estar en suspensión o fuera de tu red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne répond plus. Les entrées ne passent pas. L'appareil est peut-être en veille ou hors du réseau."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ parou de responder. A entrada não está chegando. Pode estar em suspensão ou fora da sua rede."
          }
        }
      }
    },
