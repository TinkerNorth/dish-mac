          }
        }
      }
    },
    "This app and the satellite speak different protocol versions. Update both to the latest version." : {
      "comment" : "Failure: 409 protocol mismatch.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova aplikacija i satelit govore različite verzije protokola. Ažurirajte oboje na najnoviju verziju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App und der Satellit sprechen unterschiedliche Protokollversionen. Aktualisiere beide auf die neueste Version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app y el satélite hablan versiones distintas del protocolo. Actualiza ambos a la última versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application et le satellite parlent des versions de protocole différentes. Mettez les deux à jour vers la dernière version."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app e o satélite falam versões diferentes do protocolo. Atualize ambos para a versão mais recente."
          }
        }
      }
    },
    "This satellite is too old for this version of Dish. Update the satellite." : {
      "comment" : "Failure: 409, the satellite's ceiling is below this app's floor.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj satelit je prestar za ovu verziju Disha. Ažurirajte satelit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Satellit ist zu alt für diese Version von Dish. Aktualisiere den Satelliten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este satélite es demasiado antiguo para esta versión de Dish. Actualiza el satélite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce satellite est trop ancien pour cette version de Dish. Mettez le satellite à jour."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este satélite é antigo demais para esta versão do Dish. Atualize o satélite."
          }
        }
      }
    },
    "This satellite needs a newer version of Dish. Update the app and retry." : {
      "comment" : "Failure: 409, the satellite's floor is above this app's version.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj satelit zahtijeva noviju verziju Disha. Ažurirajte aplikaciju i pokušajte ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Satellit benötigt eine neuere Version von Dish. Aktualisiere die App und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este satélite necesita una versión más reciente de Dish. Actualiza la aplicación y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce satellite nécessite une version plus récente de Dish. Mettez l’application à jour et réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este satélite precisa de uma versão mais recente do Dish. Atualize o aplicativo e tente novamente."
          }
        }
      }
    },
    "This satellite no longer recognizes this device. Re-pair needed." : {
      "comment" : "Failure: terminal 401.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj satelit više ne prepoznaje ovaj uređaj. Potrebno je ponovo uparivanje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Satellit erkennt dieses Gerät nicht mehr. Eine erneute Kopplung ist nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este satélite ya no reconoce este dispositivo. Hay que volver a emparejarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce satellite ne reconnaît plus cet appareil. Un nouvel appairage est nécessaire."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este satélite não reconhece mais este dispositivo. É preciso parear de novo."
          }
        }
      }
    },
    "This satellite's security identity changed. If it was reinstalled, forget it here and pair again." : {
      "comment" : "Failure: TOFU pin mismatch.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosni identitet ovog satelita se promijenio. Ako je ponovo instaliran, zaboravite ga ovdje i uparite ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherheitsidentität dieses Satelliten hat sich geändert. Falls er neu installiert wurde, entferne ihn hier und koppele erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La identidad de seguridad de este satélite cambió. Si se reinstaló, olvídalo aquí y vuelve a emparejarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'identité de sécurité de ce satellite a changé. S'il a été réinstallé, oubliez-le ici et appairez-le de nouveau."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A identidade de segurança deste satélite mudou. Se ele foi reinstalado, esqueça-o aqui e pareie de novo."
          }
        }
      }
    },
    "This version of Dish is no longer supported. Please update." : {
      "comment" : "Toast and status line when the build is below the supported floor.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova verzija Disha više nije podržana. Ažurirajte je."
          }
        },
        "de" : {
