    "Dish (Windows, Android, Linux, Mac) and Satellite are all released under LGPL-3.0, source on GitHub at github.com/TinkerNorth." : {
      "comment" : "Help & FAQ: is dish open source answer (one sentence of a paragraph).",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish (Windows, Android, Linux, Mac) i Satellite izdani su pod LGPL-3.0, izvorni kod je na GitHubu, na github.com/TinkerNorth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish (Windows, Android, Linux, Mac) und Satellite stehen alle unter LGPL-3.0, der Quellcode liegt auf GitHub unter github.com/TinkerNorth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish (Windows, Android, Linux, Mac) y Satellite se publican bajo LGPL-3.0, con el código en GitHub en github.com/TinkerNorth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish (Windows, Android, Linux, Mac) et Satellite sont tous publiés sous LGPL-3.0, code source sur GitHub à github.com/TinkerNorth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish (Windows, Android, Linux, Mac) e o Satellite são publicados sob a LGPL-3.0, com o código no GitHub em github.com/TinkerNorth."
          }
        }
      }
    },
    "Dish asks %@ to plug in this controller. Some hosts override the choice." : {
      "comment" : "Under the Emulate picker of a Moonlight pad; the argument is the host's name.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish traži od %@ da priključi ovaj kontroler. Neki hostovi zaobiđu taj izbor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish bittet %@, diesen Controller anzuschließen. Manche Hosts überschreiben die Wahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish pide a %@ que conecte este mando. Algunos hosts anulan la elección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish demande à %@ de brancher cette manette. Certains hôtes remplacent ce choix."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish pede que %@ conecte este controle. Alguns hosts substituem a escolha."
          }
        }
      }
    },
    "Dish asks GitHub for the newest release at startup and every few hours. See the privacy policy for what is sent." : {
      "comment" : "Settings toggle detail (the sibling sentence, tightened to fit a line).",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish pri pokretanju i svakih nekoliko sati pita GitHub za najnovije izdanje. Šta se šalje, pročitajte u politici privatnosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish fragt beim Start und alle paar Stunden bei GitHub nach der neuesten Version. Was gesendet wird, steht in der Datenschutzerklärung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish pregunta a GitHub por la versión más reciente al iniciarse y cada pocas horas. Consulta la política de privacidad para saber qué se envía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish demande à GitHub la version la plus récente au démarrage, puis toutes les quelques heures. La politique de confidentialité détaille ce qui est envoyé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish consulta o GitHub em busca da versão mais recente ao iniciar e a cada poucas horas. Veja na política de privacidade o que é enviado."
          }
        }
      }
    },
    "Dish can’t find any satellites. What now?" : {
      "comment" : "Help & FAQ: cant find satellites.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish ne može pronaći nijedan satelit. Što sad?"
          }
        },
        "de" : {
