    "Dish %@ · last checked %@" : {
      "comment" : "Update status line; the running version and when the last check completed.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish %@ · zadnja provjera %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish %@ · zuletzt geprüft %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish %@ · última comprobación %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish %@ · dernière vérification %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish %@ · última verificação %@"
          }
        }
      }
    },
    "Dish asks %@ to plug in this controller. Some hosts override the choice." : {
      "comment" : "Under the Emulate picker of a Moonlight pad; the argument is the host's name.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish traži od %@ da priključi ovaj kontroler. Neki hostovi zaobiđu taj izbor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish bittet %@, diesen Controller anzuschließen. Manche Hosts überschreiben die Wahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish pide a %@ que conecte este mando. Algunos hosts anulan la elección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish demande à %@ de brancher cette manette. Certains hôtes remplacent ce choix."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish pede que %@ conecte este controle. Alguns hosts substituem a escolha."
          }
        }
      }
    },
    "Dish asks GitHub for the newest release at startup and every few hours. See the privacy policy for what is sent." : {
      "comment" : "Settings toggle detail (the sibling sentence, tightened to fit a line).",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish pri pokretanju i svakih nekoliko sati pita GitHub za najnovije izdanje. Šta se šalje, pročitajte u politici privatnosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish fragt beim Start und alle paar Stunden bei GitHub nach der neuesten Version. Was gesendet wird, steht in der Datenschutzerklärung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish pregunta a GitHub por la versión más reciente al iniciarse y cada pocas horas. Consulta la política de privacidad para saber qué se envía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish demande à GitHub la version la plus récente au démarrage, puis toutes les quelques heures. La politique de confidentialité détaille ce qui est envoyé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish consulta o GitHub em busca da versão mais recente ao iniciar e a cada poucas horas. Veja na política de privacidade o que é enviado."
          }
        }
      }
    },
    "Dish closed unexpectedly last time. The report below has had your home folder, network addresses and key-like values removed." : {
      "comment" : "Crash report sheet intro (the sibling sentence, one word shorter to fit a line).",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish se prošli put neočekivano zatvorio. Iz izvještaja ispod uklonjeni su vaš početni folder, mrežne adrese i sve vrijednosti nalik ključevima."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish wurde beim letzten Mal unerwartet beendet. Aus dem Bericht unten wurden dein Home-Ordner, Netzwerkadressen und alle schlüsselartigen Werte entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish se cerró inesperadamente la última vez. Al informe de abajo se le han quitado tu carpeta personal, las direcciones de red y cualquier valor que parezca una clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish s'est fermé inopinément la dernière fois. Le rapport ci-dessous a été expurgé de votre dossier personnel, des adresses réseau et de toute valeur ressemblant à une clé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish fechou inesperadamente da última vez. O relatório abaixo teve a sua pasta pessoal, os endereços de rede e quaisquer valores parecidos com chaves removidos."
          }
        }
      }
    },
    "Dish deletes its pairing and you will need the PIN again. %@ keeps its own record of this device until you remove it there." : {
      "comment" : "Tooltip of a Moonlight host's Forget button; the argument is the host's name.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish briše svoje uparivanje i PIN će vam ponovo trebati. %@ zadržava vlastiti zapis o ovom uređaju dok ga tamo ne uklonite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish löscht die Kopplung und du brauchst die PIN erneut. %@ behält seinen eigenen Eintrag für dieses Gerät, bis du ihn dort entfernst."
          }
        },
        "es" : {
          "stringUnit" : {
