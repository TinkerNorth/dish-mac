            "value" : "Mais rápida"
          }
        }
      }
    },
    "Features only apply when your controller's hardware supports them — the controller list shows what was detected." : {
      "comment" : "Settings footnote.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcije važe samo ako ih hardver kontrolera podržava — lista kontrolera pokazuje šta je otkriveno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktionen gelten nur, wenn die Hardware deines Controllers sie unterstützt — die Controller-Liste zeigt, was erkannt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las funciones solo se aplican si el hardware de tu mando las admite — la lista de mandos muestra lo detectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctions ne s'appliquent que si le matériel de votre manette les prend en charge — la liste des manettes indique ce qui a été détecté."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os recursos só valem quando o hardware do seu controle os suporta — a lista de controles mostra o que foi detectado."
          }
        }
      }
    },
