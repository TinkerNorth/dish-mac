    "This host has a new identity, so the old pairing no longer works. Pair again to start a session." : {
      "comment" : "Banner body under was reset.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj host ima novi identitet, pa staro uparivanje više ne vrijedi. Uparite ponovo da biste pokrenuli sesiju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
