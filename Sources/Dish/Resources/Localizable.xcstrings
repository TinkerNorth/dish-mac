        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No trecho de PC para PC, ligue as duas máquinas ao roteador com Ethernet se puder."
          }
        }
      }
    },
    "For the controller-to-PC leg, a USB controller has no radio latency." : {
