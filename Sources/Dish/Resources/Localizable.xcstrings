    },
    "The pad’s audio needs USB; over Bluetooth it has no channel." : {
      "comment" : "Capability table reason: a PlayStation pad without its USB audio function.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk kontrolera treba USB; preko Bluetootha nema kanal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ton des Pads braucht USB; über Bluetooth hat er keinen Kanal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio del mando necesita USB; por Bluetooth no tiene canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le son de la manette passe par USB ; en Bluetooth, il n’a pas de canal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio do controle precisa de USB; por Bluetooth não tem canal."
          }
        }
      }
    },
    "The pad’s mic carries your voice to the host. Off sends nothing." : {
      "comment" : "Mic chip tooltip while on.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon pada prenosi vaš glas do hosta. Isključeno ne šalje ništa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon des Pads überträgt Ihre Stimme zum Host. Aus sendet nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono del mando lleva tu voz al host. Apagado no envía nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro de la manette porte votre voix vers l’hôte. Désactivé, rien n’est envoyé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone do controle leva sua voz ao host. Desligado não envia nada."
          }
        }
      }
    },
    "The release information didn't parse. Dish will retry automatically." : {
