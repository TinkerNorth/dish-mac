          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sitzung trägt höchstens vier Controller, und %@ hat bereits vier. Löse eine Verknüpfung, um Platz zu schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión admite cuatro mandos como máximo, y %@ ya tiene cuatro. Desvincula uno para hacer sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session porte quatre manettes au maximum, et %@ en a déjà quatre. Déliez-en une pour faire de la place."
