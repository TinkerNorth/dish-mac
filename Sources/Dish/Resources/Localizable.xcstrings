        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível interpretar as informações da versão. O Dish tentará novamente."
          }
        }
      }
    },
    "The satellite accepted, but the controller link would not open. Try again." : {
      "comment" : "Failure: the UDP socket could not be set up.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
