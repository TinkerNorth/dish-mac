        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmettre le gyroscope et l'accéléromètre à l'hôte — pour la visée gyroscopique dans les jeux compatibles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaminhar giroscópio e acelerômetro para o host — usado para mirar com movimento nos jogos que oferecem suporte."
          }
        }
      }
    },
    "Forward the DualSense / DualShock 4 touchpad. Controllers without a touchpad ignore this." : {
      "comment" : "Settings toggle detail.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proslijedi dodirnu ploču DualSense / DualShock 4 kontrolera. Kontroleri bez dodirne ploče ovo ignorišu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Touchpad von DualSense / DualShock 4 weiterleiten. Controller ohne Touchpad ignorieren dies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reenviar el panel táctil de DualSense / DualShock 4. Los mandos sin panel táctil lo ignoran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmettre le pavé tactile DualSense / DualShock 4. Les manettes sans pavé tactile l'ignorent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaminhar o touchpad do DualSense / DualShock 4. Controles sem touchpad ignoram isto."
          }
        }
      }
    },
    "Forwarding a controller needs the machine, not the screen, so this is off unless a game is being watched on this display." : {
      "comment" : "Settings toggle detail.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosljeđivanje kontrolera treba računar, a ne ekran, pa je ovo isključeno osim ako se igra gleda na ovom ekranu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Weiterleiten eines Controllers wird der Rechner gebraucht, nicht der Bildschirm — daher ist das aus, solange nicht ein Spiel auf dieser Anzeige verfolgt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reenviar un mando necesita el equipo, no la pantalla, así que esto está desactivado salvo que estés viendo un juego en esta pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmettre une manette nécessite la machine, pas l'écran, donc ceci est désactivé sauf si vous regardez un jeu sur cet écran."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaminhar um controle precisa da máquina, não da tela, então isto fica desligado a menos que você esteja assistindo a um jogo neste monitor."
          }
        }
      }
    },
