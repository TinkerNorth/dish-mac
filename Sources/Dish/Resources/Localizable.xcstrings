          }
        }
      }
    },
    "Follow game: the controller LED matches the host game. Off: leave the LED untouched." : {
      "comment" : "Settings light-bar detail.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prati igru: LED kontrolera prati igru na hostu. Isključeno: LED ostaje netaknut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiel folgen: die Controller-LED folgt dem Host-Spiel. Aus: die LED bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir el juego: el LED del mando sigue al juego del host. Apagado: el LED no se toca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivre le jeu : la LED de la manette suit le jeu de l'hôte. Désactivé : la LED reste inchangée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir o jogo: o LED do controle acompanha o jogo do host. Desligado: o LED fica como está."
          }
        }
      }
    },
    "Forget" : {
      "comment" : "Per-row forget action. Maps to Android `action_forget_short`.",
      "localizations" : {
        "bs" : {
