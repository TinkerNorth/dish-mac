    "%@ is no longer on %@. Pick another app." : {
      "comment" : "Banner: the picked app, then the host's name.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ više nije na %@. Odaberite drugu aplikaciju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auf %@ nicht mehr vorhanden. Wähle eine andere App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no está en %@. Elige otra app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est plus sur %@. Choisissez une autre application."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está mais em %@. Escolha outro app."
          }
        }
