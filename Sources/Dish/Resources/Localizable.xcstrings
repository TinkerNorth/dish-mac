    "Closing the lid still puts the Mac to sleep unless a display and power are connected." : {
      "comment" : "Settings, Power section footnote: macOS keeps a lidded Mac awake only in clamshell mode.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvaranje poklopca i dalje uspavljuje Mac, osim ako su priključeni ekran i napajanje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zuklappen des Deckels versetzt den Mac trotzdem in den Ruhezustand, außer ein Bildschirm und das Netzteil sind angeschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar la tapa sigue poniendo el Mac en reposo, salvo que haya una pantalla y la alimentación conectadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer le capot met quand même le Mac en veille, sauf si un écran et l'alimentation sont branchés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar a tampa ainda coloca o Mac em repouso, a menos que uma tela e a energia estejam conectadas."
          }
        }
      }
    },
    "Closing the window keeps controllers streaming. Quit from the menu bar icon." : {
      "comment" : "Settings toggle detail.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
