          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish leitet einen echten Gamecontroller, der an diesem PC steckt, über dein lokales Netzwerk an einen anderen PC weiter, auf dem Satellite läuft."
