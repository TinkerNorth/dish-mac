        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dish n'envoie ni parties ni entrées de manette ailleurs que vers le PC hôte de votre réseau local."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dish não envia jogo nem entrada de controle para lugar nenhum além do PC anfitrião na sua rede local."
          }
        }
      }
    },
    "Dish finds and connects to satellites on your Wi-Fi. Allow local network access to scan." : {
      "comment" : "The setup walk: allow local network to scan.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
