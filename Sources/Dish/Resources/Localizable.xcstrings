        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está cheio"
          }
        }
      }
    },
    "%@ is no longer available. Unplug and reconnect it, then try again." : {
      "comment" : "The apply overlay's outcome when the pad left; the argument is the pad.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ više nije dostupan. Isključite ga i ponovo povežite, zatim pokušajte ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht mehr verfügbar. Trennen und neu verbinden, dann erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no está disponible. Desconéctalo y vuelve a conectarlo, luego inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est plus disponible. Débranchez-le et reconnectez-le, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está mais disponível. Desconecte e reconecte, depois tente novamente."
          }
        }
      }
    },
    "%@ is no longer on %@. Pick another app." : {
      "comment" : "Banner: the picked app, then the host's name.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ više nije na %@. Odaberite drugu aplikaciju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auf %@ nicht mehr vorhanden. Wähle eine andere App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
