    },
    "Your controller’s button presses, sticks, and motion travel to a small free helper called Satellite running on the host PC." : {
      "comment" : "The first-run welcome: how it works body (one sentence of a paragraph).",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisci dugmadi, palice i pokret vašeg kontrolera putuju do malog besplatnog pomoćnika Satellite koji radi na PC-u domaćinu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastendrücke, Sticks und Bewegung deines Controllers wandern zu einem kleinen kostenlosen Helfer namens Satellite auf dem Host-PC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pulsaciones de botones, los sticks y el movimiento de tu mando viajan a un pequeño ayudante gratuito llamado Satellite que se ejecuta en el PC anfitrión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appuis de boutons, les sticks et le mouvement de votre manette voyagent jusqu'à un petit assistant gratuit appelé Satellite, qui tourne sur le PC hôte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões, os analógicos e o movimento do seu controle chegam a um pequeno ajudante gratuito chamado Satellite, que roda no PC anfitrião."
          }
        }
      }
    },
