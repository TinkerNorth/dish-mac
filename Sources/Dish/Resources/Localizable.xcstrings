            "value" : "Beim Schließen des Fensters streamen die Controller weiter. Beenden geht über das Menüleistensymbol."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar la ventana los mandos siguen transmitiendo. Sal desde el icono de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer la fenêtre laisse les manettes diffuser. Quittez depuis l'icône de la barre des menus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar a janela mantém os controles transmitindo. Saia pelo ícone da barra de menus."
          }
        }
      }
    },
