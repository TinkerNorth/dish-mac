          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir el juego: el LED del mando sigue al juego del host. Apagado: el LED no se toca."
          }
        },
        "fr" : {
          "stringUnit" : {
