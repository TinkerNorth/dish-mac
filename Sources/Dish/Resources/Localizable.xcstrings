    "The release information didn't parse. Dish will retry automatically." : {
      "comment" : "Update status line.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatke o izdanju nije bilo moguće obraditi. Dish će pokušati ponovo automatski."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Release-Informationen konnten nicht gelesen werden. Dish versucht es automatisch erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo interpretar la información de la versión. Dish lo reintentará automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations de version n'ont pas pu être analysées. Dish réessaiera automatiquement."
