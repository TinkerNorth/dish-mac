    },
    "This app and the satellite speak different protocol versions. Update both to the latest version." : {
      "comment" : "Failure: 409 protocol mismatch.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova aplikacija i satelit govore različite verzije protokola. Ažurirajte oboje na najnoviju verziju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App und der Satellit sprechen unterschiedliche Protokollversionen. Aktualisiere beide auf die neueste Version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app y el satélite hablan versiones distintas del protocolo. Actualiza ambos a la última versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application et le satellite parlent des versions de protocole différentes. Mettez les deux à jour vers la dernière version."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app e o satélite falam versões diferentes do protocolo. Atualize ambos para a versão mais recente."
          }
        }
      }
    },
    "This satellite is too old for this version of Dish. Update the satellite." : {
      "comment" : "Failure: 409, the satellite's ceiling is below this app's floor.",
