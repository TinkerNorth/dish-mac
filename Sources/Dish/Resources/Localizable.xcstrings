          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app e o satélite falam versões diferentes do protocolo. Atualize ambos para a versão mais recente."
          }
        }
      }
    },
    "This build carries no crash-reporting address, so nothing is sent whatever the switch says." : {
      "comment" : "Settings footnote under the toggle.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova verzija ne nosi adresu za izvještaje o padovima, pa se ništa ne šalje bez obzira na prekidač."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build trägt keine Adresse für Absturzberichte, daher wird nichts gesendet, egal wie der Schalter steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta compilación no lleva ninguna dirección de informes de fallos, así que no se envía nada diga lo que diga el interruptor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version ne contient aucune adresse de rapport de plantage ; rien n’est envoyé, quelle que soit la position du commutateur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta compilação não traz endereço para relatórios de falha, então nada é enviado, seja qual for a posição do botão."
          }
        }
      }
    },
