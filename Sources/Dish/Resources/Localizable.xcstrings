    "macOS is blocking Dish from the local network. Check Privacy & Security › Local Network, or add the satellite by address." : {
      "comment" : "Failure: macOS refused the app every flow to the local network. The pane named is macOS's own, in each language.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blokira Dish na lokalnoj mreži. Provjerite Privacy & Security › Local Network ili dodajte satelit putem adrese."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
