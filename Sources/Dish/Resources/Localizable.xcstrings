    "The app closed on the host. Start a new session to keep using this controller." : {
      "comment" : "Banner body under ended the session.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija je zatvorena na hostu. Pokrenite novu sesiju da nastavite koristiti ovaj kontroler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wurde auf dem Host geschlossen. Starte eine neue Sitzung, um diesen Controller weiter zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se cerró en el host. Inicia una sesión nueva para seguir usando este mando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appli s'est fermée sur l'hôte. Lancez une nouvelle session pour continuer à utiliser cette manette."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app foi fechado no host. Inicie uma nova sessão para continuar usando este controle."
          }
        }
      }
    },
    "The app started but the stream did not come up, so Dish closed it again." : {
      "comment" : "Banner body under Could not finish the session.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija se pokrenula, ali strim nije podignut, pa ju je Dish opet zatvorio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App startete, aber der Stream kam nicht zustande, also hat Dish sie wieder geschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app arrancó pero la transmisión no se estableció, así que Dish la cerró de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appli a démarré mais le flux ne s'est pas établi, alors Dish l'a refermée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app iniciou, mas a transmissão não subiu, então o Dish o fechou de novo."
          }
        }
      }
    },
    "The controller sent nothing during the test." : {
      "comment" : "Inspector result.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroler tokom testa nije poslao ništa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Controller hat während des Tests nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mando no envió nada durante la prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manette n'a rien envoyé pendant le test."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O controle não enviou nada durante o teste."
          }
        }
      }
    },
    "The host doesn’t carry %@." : {
      "comment" : "Capability help, the host layer; the argument is the feature.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host nema kanal za %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host überträgt %@ nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El host no transmite %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hôte ne transmet pas %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O host não transmite %@."
          }
        }
      }
    },
    "The host has a session but would not hand it back. Close the app on %@ and start a new one." : {
      "comment" : "Banner body; the argument is the host's name.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host ima sesiju, ali je ne vraća. Zatvorite aplikaciju na %@ i pokrenite novu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host hat eine Sitzung, gibt sie aber nicht zurück. Schließe die App auf %@ und starte eine neue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El host tiene una sesión pero no la devuelve. Cierra la app en %@ e inicia una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hôte a une session mais refuse de la rendre. Fermez l'appli sur %@ et lancez-en une nouvelle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O host tem uma sessão, mas não a devolve. Feche o app em %@ e inicie uma nova."
          }
        }
      }
    },
    "The microphone could not be opened." : {
