    "Setup fills this diagram in, one answer at a time — and hands it back finished." : {
      "comment" : "The setup walk: setup fills this diagram in.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavljanje popunjava ovaj dijagram, jedan po jedan odgovor — i vraća ga gotovog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einrichtung füllt dieses Diagramm Antwort für Antwort aus — und gibt es fertig zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración rellena este diagrama, una respuesta a la vez — y te lo devuelve terminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration remplit ce schéma, une réponse à la fois — et vous le rend terminé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração preenche este diagrama, uma resposta por vez — e o devolve pronto."
          }
        }
      }
    },
    "Share anonymized crash logs and stack traces with TinkerNorth to help fix bugs. No gameplay or controller input is included." : {
      "comment" : "Settings toggle detail.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podijelite anonimne dnevnike padova i stack trace s TinkerNorthom kako biste pomogli u ispravljanju grešaka. Igra ni unos kontrolera nisu uključeni."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile anonymisierte Absturzprotokolle und Stack-Traces mit TinkerNorth, um Bugs zu beheben. Spielgeschehen und Controller-Eingaben sind nicht enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte registros de fallos anonimizados y rastreos de pila con TinkerNorth para ayudar a corregir errores. No se incluyen partidas ni entradas del mando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez avec TinkerNorth des journaux de plantage anonymisés et des traces de pile pour aider à corriger les bugs. Aucune partie ni entrée de manette n'est incluse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe logs de falhas anonimizados e stack traces com a TinkerNorth para ajudar a corrigir bugs. Nenhum jogo ou entrada de controle é incluído."
          }
        }
      }
    },
