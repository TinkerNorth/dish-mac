          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitet das Touchpad dieses Pads als Touchpad an das Spiel weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
