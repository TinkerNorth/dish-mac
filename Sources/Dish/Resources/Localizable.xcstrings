      }
    },
    "%@ is running a different Satellite version. Update both, then pair again." : {
      "comment" : "Pairing card: no protocol version both ends speak; the argument is the satellite's name.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pokreće drugu verziju aplikacije Satellite. Ažurirajte obje strane, pa ponovo uparite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ läuft eine andere Satellite-Version. Aktualisiere beide und koppele dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ejecuta una versión distinta de Satellite. Actualiza ambos y vuelve a emparejar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exécute une version différente de Satellite. Mettez les deux à jour, puis appairez de nouveau."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está executando uma versão diferente do Satellite. Atualize os dois e pareie de novo."
          }
        }
      }
    },
    "%@ is running an app for another device and will not hand it over. Close it to start a new one, or try again later." : {
      "comment" : "Banner body; the argument is the host's name.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vodi aplikaciju za drugi uređaj i neće predati tu sesiju. Zatvorite je da pokrenete novu ili dodajte kontroler pa pokušajte kasnije."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ führt eine App für ein anderes Gerät aus und gibt diese Sitzung nicht ab. Schließe sie, um eine neue zu starten, oder füge den Controller hinzu und versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ejecuta una app para otro dispositivo y no cederá esa sesión. Ciérrala para iniciar una nueva, o añade el mando e inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exécute une appli pour un autre appareil et ne cédera pas cette session. Fermez-la pour en lancer une nouvelle, ou ajoutez la manette et réessayez plus tard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está executando um app para outro dispositivo e não vai entregar essa sessão. Feche-a para iniciar uma nova, ou adicione o controle e tente mais tarde."
          }
        }
      }
    },
    "%@ keeps disconnecting" : {
