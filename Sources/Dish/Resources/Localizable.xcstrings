          }
        }
      }
    },
    "The app started but the stream did not come up, so Dish closed it again." : {
      "comment" : "Banner body under Could not finish the session.",
      "localizations" : {
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija se pokrenula, ali strim nije podignut, pa ju je Dish opet zatvorio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App startete, aber der Stream kam nicht zustande, also hat Dish sie wieder geschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app arrancó pero la transmisión no se estableció, así que Dish la cerró de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
